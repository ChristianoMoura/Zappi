# Opcional. Copie para infra/.env somente se precisar mudar os valores padrão.
# Estes valores são apenas para o banco local. Nunca coloque aqui as credenciais do Supabase.
POSTGRES_DB=zappi
POSTGRES_USER=zappi
POSTGRES_PASSWORD=zappi_local
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Hash BCrypt da senha da Lídia, para os dados iniciais (peça para a equipe).
# Use aspas simples, porque o hash tem cifrões: LIDIA_SENHA_HASH='<hash>'
LIDIA_SENHA_HASH=
